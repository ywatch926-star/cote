{
  "schema_version": "2.0.0",
  "description": "Presets v2 — reconstruits depuis l'analyse réelle des projets .aep de la release CC. Chaîne exacte : S_Sharpen(x3) → BCC Unsharp Mask(x3) → MB Looks (ACES 1.0.3→Rec.709) → S_Glow(x2).",
  "ae_project_analyzed": [
    "AEditz Quality CC 2 {AE26}.aep",
    "Mreditz x AEditz CC - Giveaway.aep"
  ],
  "extracted_effect_chain": {
    "ae26_premium": [
      "S_Sharpen (Sharpen Amp, Width, Luma, Chroma, Red, Green, Blue) × 3 passes",
      "BCC Unsharp Mask (Radius, Amount, Threshold, Pre Smoothing, Preserve Contrast, Gamma) × 3 passes",
      "MB LookSuite3 — OCIO: aces_1.0.3 → Output - Rec.709, Strength param",
      "S_Glow (Brightness, Color, Threshold, Glow Width, Source Opacity, Bg Brightness) × 2 instances"
    ],
    "mreditz_simple": [
      "ADBE Brightness & Contrast 2",
      "ADBE CurvesCustom (S-curve)",
      "ADBE Unsharp Mask2",
      "BCC3 Unsharp Mask"
    ],
    "color_pipeline": {
      "input_colorspace": "sRGB",
      "working_space": "ACES 1.0.3 (ACEScct)",
      "output_colorspace": "Rec.709 Gamma 2.4",
      "ocio_config": "aces_1.0.3",
      "base_color_profile": "Rec.709 Gamma 2.4"
    }
  },
  "mapping_reference": {
    "S_Sharpen": "unsharp (multi-pass: 3 passes avec paramètres différents)",
    "BCC3Unsharp Mask": "unsharp (multi-pass: 3 passes avec Radius/Amount/Threshold)",
    "MB LookSuite3 + OCIO ACES→Rec709": "curves + eq + colorbalance (simule la transform ACES)",
    "S_Glow": "gblur + blend=screen (simule le glow/bloom)",
    "ADBE Brightness & Contrast 2": "eq=brightness + eq=contrast",
    "ADBE CurvesCustom": "curves=m=...",
    "ADBE Unsharp Mask2": "unsharp"
  },
  "presets": {
    "clean_realistic": {
      "description": "Reproduction fidèle de la chaîne AE26 : netteté multi-couche, grade ACES→Rec.709, glow doux.",
      "ae_source": "AEditz Quality CC 2 {AE26}.aep",
      "layers": [
        {
          "id": "s_sharpen_pass1",
          "effect": "S_Sharpen (pass 1 — detail fin)",
          "ae_effect": "S_Sharpen",
          "ae_params": {"sharpen_amp": "~1.57", "sharpen_width": "narrow", "sharpen_luma": "on", "sharpen_chroma": "off"},
          "enabled": true,
          "opacity": 1.0,
          "ffmpeg_filter": "unsharp=3:3:0.50:3:3:0",
          "notes": "Pass 1 S_Sharpen: Sharpen Amp élevé, Width étroit, Luma only"
        },
        {
          "id": "s_sharpen_pass2",
          "effect": "S_Sharpen (pass 2 — detail large)",
          "ae_effect": "S_Sharpen",
          "ae_params": {"sharpen_amp": "~1.57", "sharpen_width": "wide", "sharpen_luma": "on"},
          "enabled": true,
          "opacity": 1.0,
          "ffmpeg_filter": "unsharp=7:7:0.30:7:7:0",
          "notes": "Pass 2 S_Sharpen: Width large pour la structure globale"
        },
        {
          "id": "s_sharpen_pass3",
          "effect": "S_Sharpen (pass 3 — micro-texture)",
          "ae_effect": "S_Sharpen",
          "ae_params": {"sharpen_amp": "~1.57", "edge_threshold": "0.0339"},
          "enabled": true,
          "opacity": 1.0,
          "ffmpeg_filter": "unsharp=5:5:0.20:5:5:0",
          "notes": "Pass 3 S_Sharpen: micro-texture avec edge threshold (0.0339)"
        },
        {
          "id": "bcc_unsharp_pass1",
          "effect": "BCC Unsharp Mask (pass 1 — contraste local)",
          "ae_effect": "BCC3Unsharp Mask",
          "ae_params": {"radius": "moderate", "amount": "~15.77", "threshold": "42", "pre_smoothing": "42", "preserve_contrast": "32.5"},
          "enabled": true,
          "opacity": 1.0,
          "ffmpeg_filter": "unsharp=5:5:0.40:5:5:3",
          "notes": "BCC Unsharp Mask pass 1: Amount élevé, Threshold 42"
        },
        {
          "id": "bcc_unsharp_pass2",
          "effect": "BCC Unsharp Mask (pass 2 — structure)",
          "ae_effect": "BCC3Unsharp Mask",
          "ae_params": {"radius": "wide", "amount": "~15.77", "threshold": "42"},
          "enabled": true,
          "opacity": 1.0,
          "ffmpeg_filter": "unsharp=7:7:0.35:7:7:2",
          "notes": "BCC Unsharp Mask pass 2: radius large pour la structure"
        },
        {
          "id": "bcc_unsharp_pass3",
          "effect": "BCC Unsharp Mask (pass 3 — finition)",
          "ae_effect": "BCC3Unsharp Mask",
          "ae_params": {"radius": "narrow", "amount": "moderate", "gamma": "130"},
          "enabled": true,
          "opacity": 0.7,
          "ffmpeg_filter": "unsharp=3:3:0.25:3:3:0",
          "notes": "BCC Unsharp Mask pass 3: finition légère, gamma élevé (130)"
        },
        {
          "id": "aces_color_grade",
          "effect": "MB LookSuite3 + OCIO ACES 1.0.3 → Rec.709",
          "ae_effect": "MB LookSuite3",
          "ae_params": {"ocio_config": "aces_1.0.3", "output": "Output - Rec.709", "base_profile": "Rec.709 Gamma 2.4", "strength": "parametrizable"},
          "enabled": true,
          "opacity": 1.0,
          "ffmpeg_filter": "curves=m='0/0.01 0.05/0.04 0.1/0.09 0.2/0.18 0.3/0.28 0.4/0.39 0.5/0.50 0.6/0.61 0.7/0.72 0.8/0.83 0.9/0.92 1/1',eq=contrast=1.05:brightness=0.008:saturation=0.97:gamma=1.02,colorbalance=rs=-0.008:gs=0.0:bs=0.008:rm=0.005:gm=0.0:bm=-0.005",
          "notes": "Simule ACES 1.0.3→Rec.709: lift blacks, compress highlights, légère désaturation, teinte froide shadows / chaude midtones"
        },
        {
          "id": "s_glow_pass1",
          "effect": "S_Glow (pass 1 — glow large)",
          "ae_effect": "S_Glow",
          "ae_params": {"brightness": "moderate", "threshold": "~195", "glow_width": "wide", "source_opacity": "parametrizable", "bg_brightness": "parametrizable"},
          "enabled": true,
          "opacity": 0.35,
          "ffmpeg_filter": "split[main][glow];[glow]boxblur=20:20[blurred];[blurred]curves=m='0/0 0.7/0.72 0.9/0.96 1/1'[glowbright];[main][glowbright]blend=all_mode=screen:all_opacity=0.35",
          "notes": "S_Glow pass 1: Glow Width large (boxblur 20), Threshold élevé (195), Screen blend"
        },
        {
          "id": "s_glow_pass2",
          "effect": "S_Glow (pass 2 — glow serré)",
          "ae_effect": "S_Glow",
          "ae_params": {"brightness": "low", "glow_width": "narrow", "opacity": "parametrizable"},
          "enabled": true,
          "opacity": 0.15,
          "ffmpeg_filter": "split[main][glow];[glow]boxblur=8:8[blurred];[blurred]curves=m='0/0 0.8/0.82 1/1'[glowbright];[main][glowbright]blend=all_mode=screen:all_opacity=0.15",
          "notes": "S_Glow pass 2: Glow Width serré pour un halos plus défini"
        }
      ],
      "global": {
        "output_codec": "libx264",
        "preset": "slow",
        "crf": 18,
        "pix_fmt": "yuv420p",
        "movflags": "+faststart",
        "audio_policy": "copy"
      }
    },
